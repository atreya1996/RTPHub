{
  "id": "acq_loyalty",
  "title": "Loyalty + Cashback",
  "entry": "wallet_preview",
  "steps": {
    "wallet_preview": {
      "screen": "LoyaltyWalletPreview",
      "on": {
        "PREVIEW_CONFIRMED": "redemption_details"
      }
    },
    "redemption_details": {
      "screen": "LoyaltyRedemptionDetails",
      "on": {
        "REDEMPTION_CONFIRMED": "authenticate"
      }
    },
    "authenticate": {
      "screen": "PaymentAuthentication",
      "on": {
        "AUTH_SUCCESS": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1000,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "receipt"
      }
    },
    "receipt": {
      "screen": "AcquiringReceipt",
      "props": {
        "flowLabel": "Loyalty + Cashback",
        "txId": "ID-LOY-24001",
        "amount": 23.4
      },
      "on": {
        "DONE": "flow_final_success"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "Loyalty + Cashback"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}