{
  "id": "bills_agentic",
  "title": "Agentic Bills",
  "entry": "chat_fetch",
  "steps": {
    "chat_fetch": {
      "screen": "ChatAgent",
      "props": {
        "mode": "fetch"
      },
      "on": {
        "FETCH_BILLS": "chat_ingested",
        "BILLS_FETCHED": "chat_ingested",
        "UPLOAD": "chat_ingested"
      }
    },
    "chat_ingested": {
      "screen": "ChatAgent",
      "props": {
        "mode": "ingested",
        "attachmentType": "Photo/doc"
      },
      "on": {
        "EXTRACTION_CONFIRMED": "chat_confirm"
      }
    },
    "chat_confirm": {
      "screen": "ChatAgent",
      "props": {
        "mode": "confirm"
      },
      "on": {
        "CANCEL": "chat_fetch",
        "PAY": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1500,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "receipt",
        "FAILURE": "failed"
      }
    },
    "receipt": {
      "screen": "ChatAgent",
      "props": {
        "mode": "success",
        "receiptId": "RCT-2026-00182"
      },
      "on": {
        "DONE": "flow_final_success"
      }
    },
    "failed": {
      "screen": "ChatAgent",
      "props": {
        "mode": "failure"
      },
      "on": {
        "RETRY": "processing",
        "DONE": "flow_final_failure"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "Agentic Bills"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    },
    "flow_final_failure": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "FAILURE",
        "flowLabel": "Agentic Bills"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}
