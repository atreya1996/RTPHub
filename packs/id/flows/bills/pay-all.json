{
  "id": "bills_pay_all",
  "title": "Pay All Bills",
  "entry": "pay_all",
  "steps": {
    "pay_all": {
      "screen": "PayAllBills",
      "on": {
        "PAY_ALL": "results"
      }
    },
    "results": {
      "screen": "ExecutionResultsList",
      "on": {
        "DONE": "flow_final_success"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "Pay All Bills"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}