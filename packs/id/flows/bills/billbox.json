{
  "id": "bills_billbox",
  "title": "BillBox",
  "entry": "billbox",
  "steps": {
    "billbox": {
      "screen": "BillInbox",
      "on": {
        "PAY_SELECTED": "confirmation"
      }
    },
    "confirmation": {
      "screen": "BillPaymentConfirmation",
      "props": {
        "biller": "TNG Electricity Bill",
        "reference": "ELEC-1182-4041",
        "amount": 182.3,
        "timestamp": "2026-01-18 10:32"
      },
      "on": {
        "CONFIRM": "payment_authentication"
      }
    },
    "payment_authentication": {
      "screen": "PaymentAuthentication",
      "on": {
        "AUTH_SUCCESS": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1200,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "success_receipt",
        "FAILURE": "failed"
      }
    },
    "success_receipt": {
      "screen": "BillPaymentReceipt",
      "props": {
        "status": "SUCCESS",
        "biller": "TNG Electricity Bill",
        "reference": "ELEC-1182-4041",
        "amount": 182.3,
        "timestamp": "2026-01-18 10:33"
      },
      "on": {
        "VIEW_PAID_RECEIPTS": "paid_receipts",
        "DONE": "flow_final_success"
      }
    },
    "paid_receipts": {
      "screen": "PaidReceiptsList",
      "on": {
        "OPEN_RECEIPT": "receipt_details",
        "DONE": "flow_final_success"
      }
    },
    "receipt_details": {
      "screen": "PaidReceiptDetails",
      "props": {
        "biller": "TNG Electricity Bill",
        "reference": "ELEC-1182-4041",
        "amount": 182.3,
        "timestamp": "2026-01-18 10:33"
      },
      "on": {
        "DONE": "flow_final_success"
      }
    },
    "failed": {
      "screen": "BillPaymentReceipt",
      "props": {
        "status": "FAILED",
        "biller": "TNG Electricity Bill",
        "reference": "ELEC-1182-4041",
        "amount": 182.3,
        "timestamp": "2026-01-18 10:33"
      },
      "on": {
        "DONE": "flow_final_failure"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "BillBox"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    },
    "flow_final_failure": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "FAILURE",
        "flowLabel": "BillBox"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}