{
  "id": "acq_static_qr",
  "title": "Static QR",
  "entry": "scan_qr",
  "steps": {
    "scan_qr": {
      "screen": "ScanQR",
      "on": {
        "SCANNED": "enter_amount"
      }
    },
    "enter_amount": {
      "screen": "EnterAmount",
      "props": {
        "suggested": [
          5,
          10,
          20
        ]
      },
      "on": {
        "AMOUNT_CONFIRMED": "merchant_confirm"
      }
    },
    "merchant_confirm": {
      "screen": "StaticQRMerchantConfirm",
      "on": {
        "MERCHANT_CONFIRMED": "authenticate"
      }
    },
    "authenticate": {
      "screen": "PaymentAuthentication",
      "on": {
        "AUTH_SUCCESS": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1200,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "receipt"
      }
    },
    "receipt": {
      "screen": "AcquiringReceipt",
      "props": {
        "flowLabel": "Static QR",
        "txId": "TH-SQR-24001",
        "amount": 18
      },
      "on": {
        "DONE": "flow_final_success"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "Static QR"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}