{
  "id": "acq_cashback",
  "title": "Cashback",
  "entry": "authenticate",
  "steps": {
    "authenticate": {
      "screen": "PaymentAuthentication",
      "on": {
        "AUTH_SUCCESS": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1000,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "flow_final_success"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "Cashback",
        "txId": "MY-CB-24001",
        "amount": 23.4,
        "cashbackAmount": 1.17,
        "cashbackDestinationWallet": "Rewards Wallet"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}
