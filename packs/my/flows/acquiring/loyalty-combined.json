{
  "id": "acq_loyalty_combined",
  "title": "Loyalty + Cashback",
  "entry": "wallet_preview",
  "steps": {
    "wallet_preview": {
      "screen": "LoyaltyWalletPreview",
      "on": {
        "PREVIEW_CONFIRMED": "redemption_details"
      }
    },
    "redemption_details": {
      "screen": "LoyaltyRedemptionDetails",
      "props": {
        "pointsUsed": 500,
        "remainingPayable": 18.4,
        "pointsEarned": 60
      },
      "on": {
        "REDEMPTION_CONFIRMED": "authenticate"
      }
    },
    "authenticate": {
      "screen": "PaymentAuthentication",
      "on": {
        "AUTH_SUCCESS": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1000,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "flow_final_success"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "Loyalty + Cashback",
        "txId": "MY-LOY-COMBO-24001",
        "amount": 18.4,
        "pointsEarned": 60,
        "pointsUsed": 500,
        "remainingPayable": 18.4,
        "cashbackAmount": 1.17,
        "cashbackDestinationWallet": "Rewards Wallet"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}
