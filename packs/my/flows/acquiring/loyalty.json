{
  "id": "acq_loyalty",
  "title": "Loyalty + Cashback",
  "entry": "loyalty",
  "steps": {
    "loyalty": {
      "screen": "LoyaltySummary",
      "on": {
        "CONTINUE": "confirm"
      }
    },
    "confirm": {
      "screen": "ConfirmPay",
      "on": {
        "PAY": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1000,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "receipt",
        "FAILURE": "failed"
      }
    },
    "receipt": {
      "screen": "PaymentResult",
      "props": {
        "status": "SUCCESS"
      },
      "on": {
        "DONE": "END"
      }
    },
    "failed": {
      "screen": "PaymentResult",
      "props": {
        "status": "FAILED",
        "retry": true
      },
      "on": {
        "RETRY": "processing",
        "DONE": "END"
      }
    }
  }
}