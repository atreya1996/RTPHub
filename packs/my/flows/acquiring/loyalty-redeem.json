{
  "id": "acq_loyalty_redeem",
  "title": "Loyalty Redeem",
  "entry": "redemption_details",
  "steps": {
    "redemption_details": {
      "screen": "LoyaltyRedemptionDetails",
      "props": {
        "pointsUsed": 500,
        "remainingPayable": 18.4,
        "pointsEarned": 0
      },
      "on": {
        "REDEMPTION_CONFIRMED": "authenticate"
      }
    },
    "authenticate": {
      "screen": "PaymentAuthentication",
      "on": {
        "AUTH_SUCCESS": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1000,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "flow_final_success"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "Loyalty Redeem",
        "txId": "MY-LOY-RED-24001",
        "amount": 18.4,
        "pointsUsed": 500,
        "remainingPayable": 18.4
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}
