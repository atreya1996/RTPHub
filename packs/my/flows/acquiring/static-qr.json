{
  "id": "acq_static_qr",
  "title": "Static QR",
  "entry": "scan_qr",
  "steps": {
    "scan_qr": {
      "screen": "ScanQR",
      "on": {
        "SCANNED": "review_pay"
      }
    },
    "review_pay": {
      "screen": "StaticQRReviewPay",
      "props": {
        "suggested": [
          5,
          10,
          20
        ]
      },
      "on": {
        "PAY": "processing",
        "AUTH_REQUIRED": "authenticate"
      }
    },
    "authenticate": {
      "screen": "PaymentAuthentication",
      "on": {
        "AUTH_SUCCESS": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1200,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "success"
      }
    },
    "success": {
      "screen": "PaymentResult",
      "props": {
        "status": "SUCCESS"
      },
      "on": {
        "DONE": "receipt"
      }
    },
    "receipt": {
      "screen": "AcquiringReceipt",
      "props": {
        "flowLabel": "Static QR",
        "txId": "MY-SQR-24001",
        "amount": 18
      },
      "on": {
        "DONE": "END"
      }
    }
  }
}
