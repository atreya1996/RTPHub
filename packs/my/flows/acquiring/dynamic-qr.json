{
  "id": "acq_dynamic_qr",
  "title": "Dynamic QR",
  "entry": "invoice",
  "steps": {
    "invoice": {
      "screen": "DynamicQRInvoice",
      "on": {
        "INVOICE_REVIEWED": "offer_details"
      }
    },
    "offer_details": {
      "screen": "DynamicQROfferDetails",
      "on": {
        "OFFERS_ACCEPTED": "authenticate"
      }
    },
    "authenticate": {
      "screen": "PaymentAuthentication",
      "on": {
        "AUTH_SUCCESS": "processing"
      }
    },
    "processing": {
      "screen": "Processing",
      "simulate": {
        "delayMs": 1400,
        "result": "SUCCESS"
      },
      "on": {
        "SUCCESS": "receipt"
      }
    },
    "receipt": {
      "screen": "AcquiringReceipt",
      "props": {
        "flowLabel": "Dynamic QR",
        "txId": "MY-DQR-24001",
        "amount": 52.8
      },
      "on": {
        "DONE": "flow_final_success"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "Dynamic QR"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}