{
  "id": "bills_pay_all",
  "title": "Pay All Bills",
  "entry": "selection_summary",
  "steps": {
    "selection_summary": {
      "screen": "PayAllBills",
      "on": {
        "PAY_ALL": "auth"
      }
    },
    "auth": {
      "screen": "PaymentAuthentication",
      "on": {
        "AUTH_SUCCESS": "payment_confirmation"
      }
    },
    "payment_confirmation": {
      "screen": "PaymentResult",
      "props": {
        "status": "SUCCESS"
      },
      "on": {
        "DONE": "receipts_access"
      }
    },
    "receipts_access": {
      "screen": "AcquiringReceipt",
      "on": {
        "DONE": "flow_final_success"
      }
    },
    "flow_final_success": {
      "screen": "FlowFinalScreen",
      "props": {
        "status": "SUCCESS",
        "flowLabel": "Pay All Bills"
      },
      "on": {
        "BACK_TO_HUB": "END"
      }
    }
  }
}
